# Where the contact form POSTs its JSON payload.
#
# Leave this unset and the form degrades gracefully: submitting opens the
# visitor's mail client addressed to contact@vidika.co with the message
# pre-filled, so the page is never a dead end.
#
# Set it to a form backend (Formspree, Web3Forms, Basin, or your own handler)
# to receive submissions properly. The POST body is JSON:
#   { name, email, message, elapsedMs }
#
# PUBLIC_CONTACT_ENDPOINT=https://formspree.io/f/xxxxxxxx
