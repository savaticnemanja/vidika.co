# Copy to .env. Never committed — .gitignore covers it.
#
# This one file has two jobs, on two different machines:
#
#   locally    front-end config for `astro dev`. Only PUBLIC_-prefixed
#              variables reach the browser bundle.
#   on the box the env file `docker compose` reads, next to
#              docker-compose.yml, which is where the mail credentials live.
#
# Nothing here enters the image: .dockerignore excludes it, and compose passes
# the values in at runtime. Keep it `chmod 600` on the server.

# ══ Server: the contact handler ═══════════════════════════════════════
# Everything in this section is only read on the host running Docker.

# Required. Compose refuses to start without it, on purpose: with no key the
# handler falls back to printing messages instead of sending them, and a
# production box that silently swallows enquiries is worse than one that fails.
#
# Create it at https://resend.com/api-keys with **Sending access** only.
# vidika.co must be added under Domains and read "Verified" first, or every
# send is rejected outright.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — these all default to the values below, which match
# src/site.config.ts. MAIL_FROM's domain must be the verified one; MAIL_TO must
# be a mailbox that genuinely receives mail, since Resend sends but does not
# host inboxes (Cloudflare Email Routing is the free way to get one).
# MAIL_FROM=VIDIKA <studio@vidika.co>
# MAIL_TO=studio@vidika.co
# MAIL_SUBJECT_PREFIX=VIDIKA enquiry

# The branded "thank you for reaching out" note back to the visitor. On by
# default — set this to false to send nothing but the enquiry itself. Counts a
# second send against the Resend quota.
# MAIL_ACK=true

# Origin allowlist for the form. Anything else gets a 403.
# ALLOWED_ORIGINS=https://vidika.co,https://www.vidika.co

# Abuse controls. nginx throttles ahead of these (see deploy/), so these are
# the backstop that survives the proxy config being edited.
# RATE_MAX=5
# RATE_WINDOW_MS=600000
# RATE_MAX_GLOBAL=60
# MIN_ELAPSED_MS=3000

# ══ Local development ═════════════════════════════════════════════════

# Where the form POSTs. Unset it defaults to /api/contact, which is correct
# for the deployed site — the handler is on the same origin.
#
# `astro dev` does not proxy /api/contact, so to exercise the form locally,
# either run the real thing (`npm run serve`, which builds and serves both
# halves on :8787), or point this at a separately-running handler:
# PUBLIC_CONTACT_ENDPOINT=http://127.0.0.1:8787/api/contact
#
# Set it empty and the form degrades gracefully: submitting opens the visitor's
# mail client with the message pre-filled, so the page is never a dead end.
# PUBLIC_CONTACT_ENDPOINT=

# With no RESEND_API_KEY the handler prints composed messages instead of
# sending them, so the whole path is testable without credentials. Set it
# explicitly to be sure, and allow the dev origin:
# MAIL_TRANSPORT=console
# ALLOWED_ORIGINS=http://localhost:4321

# `npm run serve` reads this file; `astro dev` reads only the PUBLIC_ keys.
# In the container nothing reads it — compose passes the values in directly.

# ══ Escape hatch: any SMTP provider ═══════════════════════════════════
# The Resend transport above uses fetch and needs nothing installed, which is
# why the runtime image has no node_modules. SMTP imports nodemailer instead,
# so this path needs the commented COPY/RUN lines in the Dockerfile enabled.
#
# Ports: 587 = STARTTLS, 465 = implicit TLS. Resend's own SMTP bridge is
# smtp.resend.com:587, user "resend", the API key as the password — but the
# HTTP transport above is the better path.
# MAIL_TRANSPORT=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=studio@vidika.co
# SMTP_PASS=

# ══ Rarely touched ════════════════════════════════════════════════════
# Both are set by the Dockerfile and should not need overriding. HOST must
# stay 0.0.0.0 in a container — see the note in server/config.mjs.
# PORT=8787
# HOST=127.0.0.1
