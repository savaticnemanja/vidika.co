---
import Logo from './Logo.astro';
import { SITE } from '../site.config';
---

<section id="origin" class="panel hero" data-panel="origin" aria-labelledby="hero-title">
  <div class="hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="visually-hidden">{SITE.name} — {SITE.tagline}</span>
      <span class="hero__logo">
        <Logo label="" />
      </span>
    </h1>
  </div>

  <a class="cue" href="#about">
    <span class="visually-hidden">Scroll to the next section</span>
    <span class="cue__mouse" aria-hidden="true">
      <span class="cue__bead"></span>
    </span>
  </a>
</section>

<style>
  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hero__title {
    margin: 0;
  }

  /* One width for the whole lockup: the mark, the name and the line under it
     hold the brand vector's own spacing, so there is nothing here to stack or
     space by hand. Capped on height as well, since the logo is nearly as tall
     as it is wide and the panel has a header and a footer to clear. */
  .hero__logo {
    display: block;
    width: min(clamp(15rem, 42vmin, 26rem), 62vh);
  }

  /* ── Scroll cue ──────────────────────────────────────────────────── */

  .cue {
    position: absolute;
    bottom: calc(var(--footer-h) + var(--sp-4));
    left: 50%;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-left: -1.375rem;
    color: var(--bone-dim);
    animation: fade-up calc(var(--dur-5) * var(--motion)) var(--ease-expo) backwards;
    animation-delay: calc(1900ms * var(--motion));
    transition: color var(--dur-2) var(--ease-quart);
  }

  .cue:hover,
  .cue:focus-visible {
    color: var(--gold-lift);
  }

  .cue__mouse {
    position: relative;
    width: 1.35rem;
    height: 2.15rem;
    border: 1px solid currentColor;
    border-radius: 0.7rem;
    opacity: 0.75;
  }

  .cue__bead {
    position: absolute;
    top: 0.4rem;
    left: 50%;
    width: 3px;
    height: 6px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: currentColor;
    animation: bead calc(2200ms * var(--motion)) var(--ease-inout) infinite;
  }

  @keyframes fade-up {
    from {
      opacity: 0;
      transform: translate3d(0, 0.75rem, 0);
    }
  }

  /* The cue mirrors the gesture, not the direction of travel. A wheel is
     pushed down to move the page down, so the bead falls; a touch screen is
     swiped up to do the same, so on one the bead rises instead. Keyed to the
     pointer rather than the width — it's the input that differs, not the
     screen — matching the (pointer: fine) test motion.ts already makes. */
  @keyframes bead {
    0% {
      opacity: 0;
      transform: translateY(0);
    }

    25% {
      opacity: 1;
    }

    75% {
      opacity: 0;
      transform: translateY(0.7rem);
    }

    100% {
      opacity: 0;
      transform: translateY(0.7rem);
    }
  }

  @keyframes bead-rise {
    0% {
      opacity: 0;
      transform: translateY(0.7rem);
    }

    25% {
      opacity: 1;
    }

    75% {
      opacity: 0;
      transform: translateY(0);
    }

    100% {
      opacity: 0;
      transform: translateY(0);
    }
  }

  @media (pointer: coarse) {
    .cue__bead {
      animation-name: bead-rise;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cue__bead {
      animation: none;
      opacity: 1;
    }
  }
</style>
