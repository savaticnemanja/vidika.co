---
import { SECTIONS } from '../site.config';
---

<nav class="rail" aria-label="Section">
  <span class="rail__track" aria-hidden="true">
    <span class="rail__progress"></span>
  </span>

  <ul class="rail__list" role="list">
    {
      SECTIONS.map((section, i) => (
        <li>
          <a class="dot" href={`#${section.id}`} style={`--i:${i}`} data-rail-link={section.id}>
            <span class="dot__label" aria-hidden="true">
              <span class="dot__index">{section.index}</span>
              {section.label}
            </span>
            <span class="dot__diamond" aria-hidden="true" />
            <span class="visually-hidden">{`${section.label} — section ${section.index} of 0${SECTIONS.length}`}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .rail {
    /* One source for the dot's box, because the track is measured from it. */
    --dot-size: 2.75rem;
    /* And one for the track's, because its centring is measured from that. */
    --track-w: 2px;

    position: fixed;
    top: 50%;
    right: calc(var(--shell-x) * 0.5);
    z-index: var(--z-rail);
    transform: translateY(-50%);
    animation: rail-in calc(var(--dur-5) * var(--motion)) var(--ease-expo) backwards;
    animation-delay: calc(1200ms * var(--motion));
  }

  /* Runs centre-to-centre of the first and last diamond — half a dot in from
     each end — rather than to the edges of the list. The progress fill below
     is driven by raw scroll ratio, so the track's ends are what that ratio is
     measured against: any other length and 0 stops short of the first diamond
     while 1 overshoots the last, and the tip never lands on the mark it is
     meant to be pointing at. */
  .rail__track {
    position: absolute;
    top: calc(var(--dot-size) / 2);
    bottom: calc(var(--dot-size) / 2);
    /* Half its own width in from the centre line — derived rather than typed,
       so changing the weight can't quietly knock it off centre. */
    right: calc(50% - var(--track-w) / 2);
    width: var(--track-w);
    background: var(--line-bone);
  }

  /* --progress is written by motion.ts as the scroller moves.
   *
   * Flat brand gold, not a ramp toward --gold-lift: that ramp put the line at
   * its brightest exactly where its leading edge is, so the fill read as
   * heavier the further you scrolled. The lift belongs to hover states, not to
   * a position readout — the diamond already says which section is current.
   *
   * Grown by height rather than by scaleY, and with no transition of its own.
   * A transitioning transform promotes the fill to its own composited layer,
   * and there it is rasterised without the pixel snapping the normal painter
   * applies — so a 2px line whose x lands between pixels spreads across three
   * soft ones. That is why it thickened while the scroll was moving and
   * sharpened the moment it stopped. Height is a layout property: painted the
   * same way whether it is changing or not. It costs a layout on a 2px
   * out-of-flow element, which is nothing, and it gives up no smoothness —
   * motion.ts already writes --progress once per animation frame, so the
   * scroll itself is the easing.
   */
  .rail__progress {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--progress, 0) * 100%);
    background: var(--gold);
  }

  .rail__list {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--sp-6);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .dot {
    position: relative;
    display: grid;
    place-items: center;
    width: var(--dot-size);
    height: var(--dot-size);
  }

  .dot__diamond {
    width: 0.5rem;
    height: 0.5rem;
    border: 1px solid var(--line-strong);
    transform: rotate(45deg) scale(1);
    transition:
      background-color var(--dur-3) var(--ease-expo),
      border-color var(--dur-3) var(--ease-expo),
      transform var(--dur-3) var(--ease-expo),
      box-shadow var(--dur-3) var(--ease-expo);
  }

  .dot:hover .dot__diamond,
  .dot:focus-visible .dot__diamond {
    border-color: var(--gold-lift);
    transform: rotate(45deg) scale(1.35);
  }

  .dot[aria-current='true'] .dot__diamond {
    background-color: var(--gold);
    border-color: var(--gold);
    transform: rotate(45deg) scale(1.25);
    box-shadow: 0 0 0 4px rgb(183 137 55 / 14%), 0 0 18px -2px rgb(183 137 55 / 80%);
  }

  /* Label slides out of the rail on hover/focus. */
  .dot__label {
    position: absolute;
    right: calc(100% + 0.25rem);
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.35rem 0.6rem;
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 300;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--bone);
    background: color-mix(in srgb, var(--ink-800) 92%, transparent);
    border: 1px solid var(--line);
    opacity: 0;
    transform: translateX(0.5rem);
    transition:
      opacity var(--dur-2) var(--ease-quart),
      transform var(--dur-3) var(--ease-expo);
    pointer-events: none;
  }

  .dot__index {
    color: var(--gold);
  }

  .dot:hover .dot__label,
  .dot:focus-visible .dot__label {
    opacity: 1;
    transform: translateX(0);
  }

  @keyframes rail-in {
    from {
      opacity: 0;
      transform: translate(0.75rem, -50%);
    }
  }

  /* Two indicators saying the same thing is one too many: wherever the rail is
     shown, the scroller gives up its own scrollbar. This query is the
     complement of the one below, and lives beside it so the pair can't drift
     apart when either moves. Nothing is lost with it gone — the rail reports
     the same position, and unlike a scrollbar it can be tabbed to and used. */
  @media (min-width: 48em) and (min-height: 561px) {
    :global(.scroller) {
      scrollbar-width: none;
    }

    :global(.scroller)::-webkit-scrollbar {
      display: none;
    }
  }

  /* On narrow screens the rail would sit on top of the content column, and a
     thumb has nothing useful to aim at — snapping already does the work. */
  @media (max-width: 47.99em), (max-height: 560px) {
    .rail {
      display: none;
    }
  }
</style>
