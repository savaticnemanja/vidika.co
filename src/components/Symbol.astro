---
/**
 * The VIDIKA diamond on its own — the wordless mark used at tab size in the
 * header and on the standalone pages. The homepage shows the full lockup
 * instead; see Logo.astro.
 */
import { SYMBOL_PIECES, SYMBOL_VIEWBOX } from '../mark';

interface Props {
  /**
   * Plays the assembly entrance. Off for the small header mark, which appears
   * mid-scroll — a fly-in there would read as a glitch, not an arrival.
   */
  animate?: boolean;
  /** Empty makes the mark decorative, for use inside an already-labelled link. */
  label?: string;
}

const { animate = true, label = 'The VIDIKA diamond mark' } = Astro.props;
---

<svg
  class:list={['symbol', { 'symbol--static': !animate }]}
  viewBox={SYMBOL_VIEWBOX}
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  focusable="false"
>
  <g class="symbol__pieces">
    {
      SYMBOL_PIECES.map((piece) => (
        <path
          class="symbol__piece"
          d={piece.d}
          style={`--dx:${piece.dx}px; --dy:${piece.dy}px; --order:${piece.order}`}
        />
      ))
    }
  </g>
</svg>

<style>
  .symbol {
    width: 100%;
    height: auto;
    overflow: visible;
    color: var(--gold);
  }

  /* Inherits the colour so a host can tint the mark on hover without
     reaching into the pieces. */
  .symbol__piece {
    fill: currentColor;
    transform-box: fill-box;
    transform-origin: center;
    animation: assemble calc(var(--dur-6) * var(--motion)) var(--ease-expo) backwards;
    animation-delay: calc((160ms + var(--order) * 70ms) * var(--motion));
  }

  .symbol--static .symbol__piece {
    animation: none;
  }

  @keyframes assemble {
    from {
      opacity: 0;
      transform: translate(calc(var(--dx) * 2.6), calc(var(--dy) * 2.6)) rotate(-8deg);
    }

    to {
      opacity: 1;
      transform: translate(0, 0) rotate(0);
    }
  }
</style>
