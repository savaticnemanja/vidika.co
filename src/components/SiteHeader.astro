---
import { SOCIALS, SITE } from '../site.config';
import SocialIcon from './SocialIcon.astro';
import Symbol from './Symbol.astro';
---

<header class="header">
  <a class="header__mark" href="#origin" aria-label={`${SITE.name} — back to top`}>
    <Symbol animate={false} label="" />
  </a>

  <nav class="header__social" aria-label="VIDIKA on social platforms">
    <ul class="header__list" role="list">
      {
        SOCIALS.map((social, i) => (
          <li>
            <a
              class="social"
              href={social.href}
              target="_blank"
              rel="noopener noreferrer"
              style={`--i:${i}`}
            >
              <SocialIcon name={social.icon} />
              <span class="visually-hidden">{social.label} (opens in a new tab)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-chrome);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    height: var(--header-h);
    padding-inline: var(--shell-x);
    pointer-events: none;
  }

  .header > * {
    pointer-events: auto;
  }

  /* The brand mark, at tab size, appearing once you've left the hero. The
     negative margin pulls its 44px cell back against the shell edge, so the
     symbol's leftmost point lands the same distance inside the shell as the
     outermost social mark does on the other side. */
  .header__mark {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-inline-start: -0.6rem;
    color: var(--gold);
    opacity: 0;
    transform: scale(0.6);
    transition:
      opacity var(--dur-3) var(--ease-expo),
      transform var(--dur-3) var(--ease-expo),
      color var(--dur-2) var(--ease-quart),
      filter var(--dur-2) var(--ease-quart);
    pointer-events: none;
  }

  :global(body[data-section='origin']) .header__mark {
    pointer-events: none;
  }

  /* Requires the attribute to be present: before the section tracker has run
     there is no known section, and the mark belongs hidden — matching the
     hero — rather than showing because the selector happened to match. */
  :global(body[data-section]:not([data-section='origin'])) .header__mark {
    opacity: 1;
    transform: scale(1);
    pointer-events: auto;
  }

  /* Takes its colour from the link so the hover state can reach the pieces —
     the component's own `color` would otherwise stop it at the <svg>. The
     width is the diamond itself, edge to edge, since the mark is cropped to its
     own ink — level with the social glyphs opposite. */
  .header__mark :global(.symbol) {
    width: 1.12rem;
    color: inherit;
  }

  .header__mark:hover,
  .header__mark:focus-visible {
    color: var(--gold-lift);
    filter: drop-shadow(0 0 10px rgb(183 137 55 / 55%));
  }

  /* No pull on this side: a bordered box aligns by its border, which sits on
     the shell edge already. Only the bare mark opposite needs an optical
     correction to look level with it. */
  .header__list {
    display: flex;
    gap: var(--sp-2);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .social {
    /* The mark's entrance, offset per icon so the row arrives as a run rather
       than a block. --i is set on each link in the markup. */
    --social-delay: calc(var(--i) * 70ms * var(--motion));

    position: relative;
    display: grid;
    place-items: center;
    width: 2.375rem;
    height: 2.375rem;
    color: var(--gold);
    /* Opaque, not a wash: the header is fixed over whatever scrolls beneath it,
       and a see-through box lets section content read through the mark. */
    background-color: var(--ink-900);
    border: 1px solid var(--line);
    transition:
      opacity var(--dur-3) var(--ease-expo) var(--social-delay),
      scale var(--dur-3) var(--ease-expo) var(--social-delay),
      color var(--dur-2) var(--ease-quart),
      border-color var(--dur-2) var(--ease-quart),
      background-color var(--dur-2) var(--ease-quart);
  }

  /* The resting state, scoped to .js on the same rule as the reveal primitives
     in global.css: what brings these back is an attribute a script writes, so
     with no script to write it the hidden state is permanent. The mark opposite
     can afford that — it is a second way back to the top — but this is the only
     route to the profiles, so without JS the row simply stays up.

     The individual `scale`, not a transform: the press state below is a
     transform, and one declaration would overwrite the other. These compose
     instead, so a pressed icon is 0.94 of its revealed size. */
  :global(html.js) .social {
    opacity: 0;
    scale: 0.6;
    pointer-events: none;
  }

  /* Shown on the same terms as the mark opposite — see the note there for why
     the attribute has to be present rather than merely not 'origin'.

     The focus clause is what keeps them reachable while the hero is on screen:
     they are hidden, not removed, so a keyboard still tabs into them, and
     landing on something invisible is a dead end. Tabbing in reveals the row. */
  :global(body[data-section]:not([data-section='origin'])) .social,
  .header__social:focus-within .social {
    opacity: 1;
    scale: 1;
    pointer-events: auto;
  }

  /* Keeps the 44px pointer target the smaller visible box gives up — 3px of
     invisible reach on each side, which is still 2px clear of its neighbour's
     across the gap. */
  .social::before {
    content: '';
    position: absolute;
    inset: -3px;
  }

  .social :global(.social-icon) {
    transition: transform var(--dur-3) var(--ease-expo);
  }

  .social:hover,
  .social:focus-visible {
    color: var(--gold-lift);
    border-color: var(--line-strong);
    /* The same 12% gold as --gold-wash, mixed into the ground rather than laid
       over it, so the hover state stays opaque too. */
    background-color: color-mix(in srgb, var(--gold) 12%, var(--ink-900));
  }

  .social:hover :global(.social-icon) {
    transform: scale(1.12);
  }

  .social:active {
    transform: scale(0.94);
  }
</style>
