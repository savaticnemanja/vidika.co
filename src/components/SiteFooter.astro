---
import { CREDIT, SITE, copyrightYears } from '../site.config';

const years = copyrightYears();
---

<footer class="footer">
  <p class="footer__text">
    <span aria-hidden="true">©</span>
    <span class="visually-hidden">Copyright</span>
    {years}
    {SITE.legalName}. All rights reserved.
  </p>

  {/* The form no longer carries the GDPR art. 13 pointer — it lives here,
      reachable from every page — and the build credit runs on the same line
      after it. Both are apparatus rather than statement, which is what the
      row's smaller, quieter setting below is saying. */}
  <p class="footer__meta">
    <a href="/privacy-notice">Privacy Notice</a>
    <span class="footer__sep" aria-hidden="true">·</span>
    {/* Names the work; the studio beside it is the link. Read as one credit,
        so nothing separates them but the same dot used above. */}
    <span class="footer__credit">{CREDIT.label}</span>
    <span class="footer__sep" aria-hidden="true">·</span>
    <a href={CREDIT.href}>{CREDIT.name}</a>
  </p>
</footer>

<style>
  /* In flow, at the true end of the page, sharing the last section's ground
     rather than reading as a separate block — never floating over a section. */
  .footer {
    position: relative;
    z-index: var(--z-content);
    display: grid;
    place-items: center;
    gap: 0.1rem;
    min-height: var(--footer-block);
    padding-inline: var(--shell-x);
    padding-block-end: env(safe-area-inset-bottom, 0px);
  }

  /* Both lines run tight, and the gap above is small, so the leading is what
     you would actually be seeing between them: the body's 1.7 on the link and
     1.4 here were adding some 7px of air before the gap even began. Still loose
     enough to read on the narrow screens where the legal name wraps to two. */
  .footer__text {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    font-weight: 300;
    line-height: 1.2;
    letter-spacing: var(--tr-wide);
    color: var(--bone-dim);
    text-align: center;
    text-wrap: balance;
  }

  /*
   * A step below the copyright, and the step is taken in size rather than in
   * contrast. Dimming was the obvious way to make this recede, but --bone-dim
   * is already the dimmest bone the tokens hold at AA on this ground, and two
   * of the three items here are links that have to stay readable. Scale does
   * the same work without spending any of that: at 92% of the smallest step
   * this line reads as a caption under the statement above it, while its type
   * keeps a contrast the row above would not be ashamed of.
   *
   * What is dimmed is only what carries no information on its own — the two
   * separators, and the words naming the work rather than the studio.
   */
  .footer__meta {
    font-family: var(--font-display);
    font-size: calc(var(--fs-xs) * 0.92);
    font-weight: 300;
    /* Single line, so it can run at the type's own height — nothing above the
       ascenders here is doing any work. */
    line-height: 1.05;
    letter-spacing: var(--tr-tight);
    /* 4.8:1 — a shade under --bone-dim, still AA at this size. */
    color: rgb(237 231 219 / 52%);
    text-align: center;
    text-wrap: balance;
  }

  .footer__sep {
    margin-inline: 0.45em;
    opacity: 0.5;
  }

  /* Each item holds together, so the only place this row can break is at a
     separator — a wrapped footer still reads as whole items rather than as
     "Privacy" over "Notice". */
  .footer__meta a,
  .footer__credit {
    white-space: nowrap;
  }

  .footer__credit {
    opacity: 0.78;
  }

  .footer__meta a {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 0.2em;
    transition:
      color var(--dur-2) var(--ease-quart),
      text-decoration-color var(--dur-2) var(--ease-quart);
  }

  .footer__meta a:hover,
  .footer__meta a:focus-visible {
    color: var(--gold-lift);
    text-decoration-color: currentColor;
  }

  /* The legal name wraps to two lines on narrow screens — give it the room. */
  @media (max-width: 30em) {
    .footer__text {
      letter-spacing: var(--tr-tight);
    }

    /* Less air around the dots once the row is close to wrapping. */
    .footer__sep {
      margin-inline: 0.35em;
    }
  }
</style>
