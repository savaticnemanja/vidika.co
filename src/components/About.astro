---
import { ABOUT } from '../site.config';
import MimolandLockup from './MimolandLockup.astro';

/* Widened past the literal the config freezes it to, so this stays a runtime
   question. Compared as the two literal types, TS would rule on it here and
   the placeholder branch below would read as dead code the moment a real
   destination lands. */
const ctaReady = (ABOUT.cta.href as string) !== '#';
---

<section id="about" class="panel about" data-panel="about" aria-labelledby="about-title">
  <div class="about__inner">
    <h2 id="about-title" class="visually-hidden">{ABOUT.heading}</h2>

    <p class="about__body" data-reveal="wipe">{ABOUT.body}</p>

    <p class="about__lead" data-reveal="up" style="--reveal-delay:260ms">{ABOUT.ctaLead}</p>

    <div class="about__cta" data-reveal="up" style="--reveal-delay:400ms">
      {
        ctaReady ? (
          <a
            class="cta"
            href={ABOUT.cta.href}
            {...(ABOUT.cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            {/* The lockup is the label, so the name is carried in text beside it
                rather than on the mark — one accessible name for the link, and
                room to say where it goes. */}
            <span class="cta__lockup">
              <MimolandLockup label="" />
            </span>
            <span class="visually-hidden">
              {ABOUT.cta.label}
              {ABOUT.cta.external && ' (opens in a new tab)'}
            </span>
            <svg class="cta__trace" aria-hidden="true" focusable="false" preserveAspectRatio="none">
              <rect x="0.5" y="0.5" width="99%" height="99%" pathLength="100" />
            </svg>
          </a>
        ) : (
          <span class="cta cta--soon">
            {/* Nothing here is a link, so the mark names itself. */}
            <span class="cta__lockup">
              <MimolandLockup label={ABOUT.cta.label} />
            </span>
            <span class="cta__soon">Coming soon</span>
            <svg class="cta__trace" aria-hidden="true" focusable="false" preserveAspectRatio="none">
              <rect x="0.5" y="0.5" width="99%" height="99%" pathLength="100" />
            </svg>
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  /* The section opens on the description — no heading, no flare above it, so
     this is the first thing that lands, and it carries a display step rather
     than a reading one. --measure still caps the line, but at this size 46ch
     is wider than the column, so the container is what holds the wrap. */
  .about__body {
    max-width: var(--measure);
    font-size: var(--fs-lg);
    font-weight: 400;
    line-height: var(--lh-body);
    color: var(--bone-soft);
  }

  .about__lead {
    margin-block-start: clamp(2rem, 7vh, 4.5rem);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 300;
    letter-spacing: var(--tr-wider);
    text-transform: uppercase;
    color: var(--gold);
  }

  .about__cta {
    margin-block-start: clamp(1.25rem, 3vh, 2rem);
  }

  /* ── CTA ─────────────────────────────────────────────────────────── */

  .cta {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    min-height: 3.5rem;
    /* Less inline padding than the text label wanted, and more block. A word
       set in caps is a thin band that needs width around it to sit still; the
       lockup is a picture with its own mass, and reads framed when its clear
       space is closer to even on all four sides.

       The block half is measured in vh so it gives way on short screens, the
       same as the two margins stacked above it. The lockup is the tallest
       thing this section gained, and a panel is only min-height: 100dvh —
       anything that can't shrink here pushes the section past one screen and
       breaks the snap. */
    padding: clamp(0.95rem, 2.4vh, 1.4rem) clamp(1.75rem, 6vw, 2.75rem);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 300;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--line-strong);
    isolation: isolate;
    transition:
      color var(--dur-3) var(--ease-quart),
      border-color var(--dur-3) var(--ease-quart),
      scale var(--dur-1) var(--ease-quart);
  }

  /* Gold fill wipes in from the left, behind the label. */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, var(--gold), var(--gold-lift));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-deco);
  }

  /* Sized by height only — the lockup reads its own width off the artwork, so
     there is no second number here to fall out of step with it. The two ends
     of the clamp are the two sizes welcometomimoland.com itself uses: 26px
     under its 1080px breakpoint and 30px above, and the 2.8vw between them
     crosses over at almost exactly that width. The mark is drawn in
     currentColor, which means the .cta colour below carries it from gold to
     ink on the same transition as the border, and the hover sweep never has
     to know a logo is sitting on it. */
  .cta__lockup {
    --lockup-h: clamp(1.625rem, 2.8vw, 1.875rem);

    display: block;
  }

  .cta__trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--gold-lift);
    stroke-width: 1;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    transition:
      stroke-dashoffset var(--dur-4) var(--ease-quart),
      opacity var(--dur-1) linear;
    pointer-events: none;
  }

  .cta:hover,
  .cta:focus-visible {
    color: var(--ink-1000);
    border-color: var(--gold-lift);
  }

  .cta:hover::before,
  .cta:focus-visible::before {
    transform: scaleX(1);
  }

  .cta:hover .cta__trace,
  .cta:focus-visible .cta__trace {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  .cta:active {
    scale: 0.98;
  }

  /* Placeholder state until the Mimoland destination exists. */
  .cta--soon {
    color: var(--bone-dim);
    border-style: dashed;
    border-color: var(--line);
    cursor: default;
  }

  .cta--soon::before,
  .cta--soon .cta__trace {
    display: none;
  }

  .cta__soon {
    font-size: var(--fs-xs);
    letter-spacing: var(--tr-wide);
    color: var(--gold-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta:active {
      scale: 1;
    }
  }
</style>
