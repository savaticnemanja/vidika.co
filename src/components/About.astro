---
import { ABOUT } from '../site.config';

const ctaReady = ABOUT.cta.href !== '#';
---

<section id="about" class="panel about" data-panel="about" aria-labelledby="about-title">
  <div class="about__inner">
    <h2 id="about-title" class="about__heading" data-reveal="rise">{ABOUT.eyebrow}</h2>

    <span class="about__rule" data-reveal="rule" style="--reveal-delay:160ms" aria-hidden="true"></span>

    <p class="about__body" data-reveal="wipe" style="--reveal-delay:260ms">{ABOUT.body}</p>

    <p class="about__lead" data-reveal="up" style="--reveal-delay:520ms">{ABOUT.ctaLead}</p>

    <div class="about__cta" data-reveal="up" style="--reveal-delay:660ms">
      {
        ctaReady ? (
          <a
            class="cta"
            href={ABOUT.cta.href}
            {...(ABOUT.cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <span class="cta__label">{ABOUT.cta.label}</span>
            {ABOUT.cta.external && <span class="visually-hidden">(opens in a new tab)</span>}
            <svg class="cta__trace" aria-hidden="true" focusable="false" preserveAspectRatio="none">
              <rect x="0.5" y="0.5" width="99%" height="99%" pathLength="100" />
            </svg>
          </a>
        ) : (
          <span class="cta cta--soon">
            <span class="cta__label">{ABOUT.cta.label}</span>
            <span class="cta__soon">Coming soon</span>
            <svg class="cta__trace" aria-hidden="true" focusable="false" preserveAspectRatio="none">
              <rect x="0.5" y="0.5" width="99%" height="99%" pathLength="100" />
            </svg>
          </span>
        )
      }
    </div>
  </div>
</section>

<style>
  .about__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 40rem;
    margin-inline: auto;
    text-align: center;
  }

  .about__heading {
    font-size: var(--fs-xl);
    font-weight: 200;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--bone);
  }

  .about__rule {
    display: block;
    width: 4.5rem;
    height: 1px;
    margin-block: clamp(1rem, 3vh, 1.75rem);
    background: linear-gradient(to right, transparent, var(--gold), transparent);
  }

  .about__body {
    max-width: var(--measure);
    font-size: var(--fs-md);
    font-weight: 400;
    line-height: var(--lh-body);
    color: var(--bone-soft);
  }

  .about__lead {
    margin-block-start: clamp(2rem, 7vh, 4.5rem);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 300;
    letter-spacing: var(--tr-wider);
    text-transform: uppercase;
    color: var(--gold);
  }

  .about__cta {
    margin-block-start: clamp(1.25rem, 3vh, 2rem);
  }

  /* ── CTA ─────────────────────────────────────────────────────────── */

  .cta {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.2rem;
    min-height: 3.5rem;
    padding: 1.05rem clamp(2rem, 7vw, 3.5rem);
    font-family: var(--font-display);
    font-size: var(--fs-md);
    font-weight: 300;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--line-strong);
    isolation: isolate;
    transition:
      color var(--dur-3) var(--ease-quart),
      border-color var(--dur-3) var(--ease-quart),
      scale var(--dur-1) var(--ease-quart);
  }

  /* Gold fill wipes in from the left, behind the label. */
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, var(--gold), var(--gold-lift));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-deco);
  }

  .cta__label {
    position: relative;
    transition: transform var(--dur-3) var(--ease-expo);
  }

  .cta__trace {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
    stroke: var(--gold-lift);
    stroke-width: 1;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    transition:
      stroke-dashoffset var(--dur-4) var(--ease-quart),
      opacity var(--dur-1) linear;
    pointer-events: none;
  }

  .cta:hover,
  .cta:focus-visible {
    color: var(--ink-1000);
    border-color: var(--gold-lift);
  }

  .cta:hover::before,
  .cta:focus-visible::before {
    transform: scaleX(1);
  }

  .cta:hover .cta__trace,
  .cta:focus-visible .cta__trace {
    opacity: 1;
    stroke-dashoffset: 0;
  }

  .cta:active {
    scale: 0.98;
  }

  /* Placeholder state until the Mimoland destination exists. */
  .cta--soon {
    color: var(--bone-dim);
    border-style: dashed;
    border-color: var(--line);
    cursor: default;
  }

  .cta--soon::before,
  .cta--soon .cta__trace {
    display: none;
  }

  .cta__soon {
    font-size: var(--fs-xs);
    letter-spacing: var(--tr-wide);
    color: var(--gold-deep);
  }

  @media (prefers-reduced-motion: reduce) {
    .cta:active {
      scale: 1;
    }
  }
</style>
