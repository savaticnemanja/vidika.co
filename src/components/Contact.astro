---
import Field from './Field.astro';
import { CONTACT, SITE } from '../site.config';
---

<section id="contact" class="panel contact" data-panel="contact" aria-labelledby="contact-title">
  <div class="contact__inner">
    <h2 id="contact-title" class="contact__heading" data-reveal="rise">{CONTACT.heading}</h2>

    <form
      class="form"
      data-contact-form
      data-endpoint={CONTACT.endpoint}
      data-mailto={SITE.email}
      method="post"
      action={CONTACT.endpoint || `mailto:${SITE.email}`}
      novalidate
    >
      <div class="form__row">
        <Field
          id="contact-name"
          name="name"
          label={CONTACT.fields.name.label}
          maxlength={CONTACT.fields.name.max}
          autocomplete="name"
          delay={220}
        />

        <Field
          id="contact-email"
          name="email"
          type="email"
          label={CONTACT.fields.email.label}
          maxlength={CONTACT.fields.email.max}
          autocomplete="email"
          inputmode="email"
          delay={300}
        />
      </div>

      <Field
        id="contact-message"
        name="message"
        as="textarea"
        label={CONTACT.fields.message.label}
        maxlength={CONTACT.fields.message.max}
        counter
        delay={380}
      />

      {/* Bot trap — off-screen rather than display:none, and never announced. */}
      <div class="honeypot" aria-hidden="true">
        <label for="contact-company">Company</label>
        <input id="contact-company" name="company" type="text" tabindex="-1" autocomplete="off" />
      </div>

      <div class="form__actions" data-reveal="up" style="--reveal-delay:460ms">
        <button type="submit" class="submit" data-submit>
          <span class="submit__label" data-submit-label>Send message</span>

          {/* Nothing beside the label until there is something to say: the tick
              is the only mark, and it arrives with "Sent". */}
          <span class="submit__icon" aria-hidden="true">
            <svg class="submit__glyph submit__glyph--check" viewBox="0 0 24 24" focusable="false">
              <path d="M4 12.5 9.5 18 20 7" pathLength="100" />
            </svg>
          </span>
        </button>
      </div>

      <p class="form__status" role="status" aria-live="polite" data-form-status></p>
    </form>

    <a class="contact__email" href={`mailto:${SITE.email}`} data-reveal="fade" style="--reveal-delay:560ms">
      {SITE.email}
    </a>
  </div>
</section>

<style>
  .contact__inner {
    /* One gap, everywhere: between the two columns, between the rows, under the
       message, and under the button. Nothing inside the form is spaced by a
       margin of its own, so there is a single number to tune and the rhythm
       can't drift apart. Declared here rather than on the form so the address
       below it can measure itself against the same unit; the short-viewport
       rules tighten it in one place. */
    --form-gap: clamp(0.65rem, 1.6vh, 1rem);

    display: flex;
    flex-direction: column;
    align-items: center;
    width: 100%;
    /* The same measure the About column runs on, so the two content sections
       are one width rather than two near-misses. */
    max-width: 40rem;
    margin-inline: auto;
  }

  /* Where the rail is shown, the form is the one block wide enough to reach it:
     keep 4.5rem clear on each side so a field edge never crowds the dots. Only
     bites between 48em and ~57em — past that the measure above is the smaller
     of the two anyway. */
  @media (min-width: 48em) {
    .contact__inner {
      max-width: min(40rem, calc(100vw - 9rem));
    }
  }

  .contact__heading {
    font-size: var(--fs-xl);
    font-weight: 200;
    letter-spacing: var(--tr-wide);
    text-transform: uppercase;
    color: var(--bone);
  }

  .form {
    margin-block-start: var(--heading-gap);
    display: flex;
    flex-direction: column;
    gap: var(--form-gap);
    width: 100%;
  }

  /* Name and email share a line on desktop — two short fields stacked make the
     form read as longer than it is. One column below 48em, which is where the
     rail also switches to its compact form. */
  .form__row {
    display: grid;
    gap: var(--form-gap);
  }

  @media (min-width: 48em) {
    .form__row {
      grid-template-columns: 1fr 1fr;
    }

    /* A grid item's automatic minimum is the input's intrinsic width, which is
       wider than half this form — without this the row overflows its measure. */
    .form__row > :global(.field) {
      min-width: 0;
    }
  }

  .honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ── Submit ──────────────────────────────────────────────────────── */

  .submit {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    width: 100%;
    /* Level with the fields above it — still 44px, so it keeps the touch
       target the smaller type would otherwise have given up. */
    min-height: 2.75rem;
    padding: 0.7rem var(--sp-6);
    font-family: var(--font-display);
    font-size: var(--fs-sm);
    font-weight: 300;
    letter-spacing: var(--tr-wider);
    text-transform: uppercase;
    color: var(--gold);
    border: 1px solid var(--line-strong);
    border-radius: 2px;
    isolation: isolate;
    overflow: hidden;
    transition:
      color var(--dur-3) var(--ease-quart),
      border-color var(--dur-3) var(--ease-quart);
  }

  .submit::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, var(--gold), var(--gold-lift));
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--dur-3) var(--ease-deco);
  }

  .submit:hover,
  .submit:focus-visible {
    color: var(--ink-1000);
    border-color: var(--gold-lift);
  }

  .submit:hover::before,
  .submit:focus-visible::before {
    transform: scaleX(1);
  }

  .submit:active {
    scale: 0.99;
  }

  /* Sending — an indeterminate gold sweep travelling under the label. */
  .submit[data-state='sending'] {
    color: var(--gold-lift);
    cursor: progress;
  }

  .submit[data-state='sending']::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      90deg,
      transparent 0%,
      rgb(183 137 55 / 32%) 45%,
      rgb(214 164 79 / 45%) 50%,
      rgb(183 137 55 / 32%) 55%,
      transparent 100%
    );
    animation: sweep 1150ms var(--ease-inout) infinite;
  }

  .submit[data-state='sent'] {
    color: var(--ink-1000);
    border-color: var(--gold-lift);
    cursor: default;
  }

  .submit[data-state='sent']::before {
    transform: scaleX(1);
  }

  .submit:disabled {
    cursor: not-allowed;
  }

  /* One cell, two marks stacked in it — see the button markup. */
  /* Out of the flow until the send lands, so the idle button is its label and
     nothing else — an empty slot beside it would push the label off centre by
     half its own width. */
  .submit__icon {
    display: none;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
  }

  .submit[data-state='sent'] .submit__icon {
    display: grid;
  }

  .submit__glyph {
    width: 100%;
    height: 100%;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .submit__glyph--check {
    stroke-width: 2.2;
    stroke-dasharray: 100;
    stroke-dashoffset: 100;
    opacity: 0;
    transition: opacity var(--dur-1) linear;
  }

  .submit[data-state='sent'] .submit__glyph--check {
    opacity: 1;
    animation: draw-check calc(var(--dur-3) * var(--motion)) var(--ease-quart) forwards;
  }

  /* Like the field errors, it takes no room until it has something to say, so
     the button sits one gap above the address. When it does speak, its own
     bottom padding keeps that gap below it too. */
  .form__status {
    font-family: var(--font-display);
    font-size: var(--fs-xs);
    letter-spacing: var(--tr-tight);
    line-height: 1.35;
    text-align: center;
    color: var(--bone-dim);
  }

  .form__status:not(:empty) {
    padding-block-end: var(--form-gap);
  }

  .form__status[data-tone='error'] {
    color: #e2917f;
  }

  .form__status[data-tone='success'] {
    color: var(--gold-lift);
  }

  /* The site says everything small in Jost, light, on wide tracking — the
     footer, the eyebrows, the field labels. This was the one italic serif on
     the page, so it read as a quotation rather than an address. Left in
     lowercase: an address is typed, not announced. */
  /* The one place that doesn't take the plain form gap: this is the way round
     the form, not part of it, so it gets three quarters of a gap on top of the
     one already below the button. The top padding stays at zero so that margin
     is the whole distance, rather than the margin plus its own leading; the
     bottom padding is what the hover underline hangs from. */
  .contact__email {
    position: relative;
    margin-block-start: calc(var(--form-gap) * 0.75);
    padding-block: 0 0.35rem;
    font-family: var(--font-display);
    /* A step under the button's label: the form is the invitation, this is the
       footnote to it. */
    font-size: var(--fs-sm);
    font-weight: 300;
    /* The body's 1.7 would put half a line of leading above the address, which
       reads as a bigger gap than the one the button sits on. */
    line-height: 1.2;
    letter-spacing: var(--tr-wide);
    /* Tracking hangs off the last letter; the indent pays it back so the
       centred underline below sits square under the address. */
    text-indent: var(--tr-wide);
    color: var(--bone-soft);
    transition: color var(--dur-2) var(--ease-quart);
  }

  /* Underline grows from the centre. */
  .contact__email::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transition: transform var(--dur-3) var(--ease-expo);
  }

  .contact__email:hover,
  .contact__email:focus-visible {
    color: var(--gold-lift);
  }

  .contact__email:hover::after,
  .contact__email:focus-visible::after {
    transform: scaleX(1);
  }

  @keyframes sweep {
    from {
      transform: translateX(-100%);
    }

    to {
      transform: translateX(100%);
    }
  }

  @keyframes draw-check {
    to {
      stroke-dashoffset: 0;
    }
  }

  /* Short viewports (a common laptop window, not just landscape phones) can't
     fit the form's natural rhythm above the footer band within one screen —
     tighten the vertical rhythm so the whole section still lands as one
     viewport instead of pushing the footer past the fold. */
  @media (max-height: 820px) {
    /* The heading keeps its shared --heading-gap here — the air under a heading
       is the same everywhere, so it can't be the thing that shrinks. The form's
       own rhythm gives up the height instead. */
    .contact__inner {
      --form-gap: clamp(0.5rem, 1.2vh, 0.7rem);
    }
  }

  /* Below the point where global.css relaxes the scroll-snap lock, the form
     still needs to fit — snap-stop only loosens under 620px, so 700px down
     to that line is still a hard lock. */
  @media (max-height: 700px) {
    .contact__inner {
      --form-gap: clamp(0.35rem, 0.9vh, 0.5rem);
    }
  }
</style>
