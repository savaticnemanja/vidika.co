---
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import Ambient from '../components/Ambient.astro';
import { SITE } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  /** Pass "is-static" on pages that scroll the body instead of an inner scroller. */
  bodyClass?: string;
}

const { title, description, noindex, bodyClass } = Astro.props;
---

<!doctype html>
<html lang={SITE.locale} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    {/* Flips before first paint so reveal states never flash unstyled. */}
    <script is:inline>
      document.documentElement.classList.replace('no-js', 'js');
    </script>

    {/* The entrance animations carry the only visible state those elements
        have — see the entrance guard in global.css. WebKit suspends
        animations in a document that loads hidden (a background tab, a
        cmd-clicked link, a restored session), so the delay never elapses and
        the logo, the 404 mark and the scroll cue sit at opacity 0 for as
        long as the page lives. Park the entrance whenever it can't be
        trusted to run, and let it play once the page is actually seen. */}
    <script is:inline>
      (() => {
        const root = document.documentElement;

        if (document.visibilityState !== 'visible') {
          root.classList.add('entry-hold');

          const release = () => {
            if (document.visibilityState !== 'visible') return;
            root.classList.remove('entry-hold');
            document.removeEventListener('visibilitychange', release);
          };

          document.addEventListener('visibilitychange', release);
        }

        /* Backstop for any cause we haven't named: by now every entrance has
           had time to finish, so nothing may still be on its opening frame.
           Only elements an animation is the sole author of belong here — the
           header's social links rest at opacity 0 by design while the hero is
           on screen, and reading them as stuck would park the whole page. */
        setTimeout(() => {
          const held = document.querySelectorAll(
            '.logo__piece, .logo__letter, .logo__tagline, .symbol__piece, .cue',
          );

          for (const el of held) {
            if (parseFloat(getComputedStyle(el).opacity) < 0.05) {
              root.classList.add('entry-hold');
              return;
            }
          }
        }, 4000);
      })();
    </script>

    <Seo title={title} description={description} noindex={noindex} />

    <meta name="theme-color" content={SITE.themeColor} />
    <meta name="color-scheme" content="dark" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon-96.png" type="image/png" sizes="96x96" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {/* Both faces are used above the fold, so fetch them at highest priority. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/jost-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/cormorant-garamond-latin-wght-normal.woff2"
      crossorigin
    />
  </head>

  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <Ambient />
    <slot />
  </body>
</html>
