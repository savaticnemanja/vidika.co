{
  "id": "vidika",
  "execute-command": "/opt/deploy/vidika.co.sh",
  "command-working-directory": "/srv/vidika.co",
  "response-message": "deploying vidika.co",
  "trigger-rule": {
    "and": [
      {
        "match": {
          "type": "payload-hmac-sha256",
          "secret": "REPLACE_WITH_WEBHOOK_SECRET",
          "parameter": {
            "source": "header",
            "name": "X-Hub-Signature-256"
          }
        }
      },
      {
        "match": {
          "type": "value",
          "value": "refs/heads/main",
          "parameter": {
            "source": "payload",
            "name": "ref"
          }
        }
      }
    ]
  }
}
